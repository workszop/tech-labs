{
  "name": "agent-lab-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Service Agent Lab API gateway (Cloudflare Worker): access codes, sessions, embeddings + chat proxy, quotas, admin.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "admin": "node scripts/admin.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "^4.124.0"
  }
}
