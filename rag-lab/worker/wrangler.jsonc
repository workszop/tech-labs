// RAG Lab API gateway — Cloudflare Worker configuration.
// Secrets (never put them here):  wrangler secret put CODE_PEPPER | ADMIN_TOKEN | PROVIDER_API_KEY
// Local dev: copy .dev.vars.example → .dev.vars (sets PROVIDER=mock + dev secrets, overrides the vars below).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rag-lab-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  // Daily cleanup of expired sessions and stale rate-limit windows (UTC).
  "triggers": { "crons": ["17 3 * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rag-lab",
      "database_id": "e3b2a81b-69ef-4289-9763-2fdaae54e69e",
      "migrations_dir": "migrations"
    }
  ],

  // Optional extra per-session limiter (Workers Rate Limiting binding). D1 limiting works without it.
  // "ratelimits": [
  //   { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  // ],

  // Real models through OpenRouter (OpenAI-compatible API). The key is a Worker secret:
  //   npx wrangler secret put PROVIDER_API_KEY   (an OpenRouter key, sk-or-...)
  // PROVIDER=mock switches back to the offline demo models (no key, no cost).
  "vars": {
    "PROVIDER": "openai-compatible",
    "PROVIDER_BASE_URL": "https://openrouter.ai/api/v1",
    "EMBEDDING_MODEL": "openai/text-embedding-3-small",
    "EMBEDDING_DIMENSIONS": "1536",
    "CHAT_MODEL": "openai/gpt-6-luna",
    "CHAT_REASONING_EFFORT": "low",
    "ALLOWED_MODELS": "openai/text-embedding-3-small,openai/gpt-6-luna",
    "EMBED_TIMEOUT_MS": "20000",
    "CHAT_TIMEOUT_MS": "60000",

    "EMBEDDING_PRICE_PER_MTOK": "0.02",
    "CHAT_INPUT_PRICE_PER_MTOK": "0.10",
    "CHAT_OUTPUT_PRICE_PER_MTOK": "0.50",

    "ALLOWED_ORIGINS": "https://tech-labs.warsztaty-ai.com,https://workszop.github.io",
    // Cloudflare Access for /api/admin/* (leave empty to use only ADMIN_TOKEN).
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",

    "SESSION_TTL_MINUTES": "240",
    "SESSION_IDLE_TIMEOUT_MINUTES": "0",
    "RATE_LIMIT_PER_MINUTE": "30",
    "ACTIVATION_MAX_ATTEMPTS": "10",
    "ACTIVATION_WINDOW_SECONDS": "900",
    "ACTIVATION_GLOBAL_FAILURES_PER_MINUTE": "60",
    "ACTIVATION_MIN_RESPONSE_MS": "250",

    "DEFAULT_REQUEST_LIMIT": "300",
    "DEFAULT_TOKEN_LIMIT": "300000",
    "DEFAULT_MAX_SESSIONS": "3",

    "CLEANUP_RETENTION_DAYS": "7"
  }
}
